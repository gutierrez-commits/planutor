<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calendario - PLANUTOR V2</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        * { box-sizing: border-box; }
        body { font-family: Arial, sans-serif; background:#f7ede2; color:#2d2d2d; padding:24px; }
        .contenedor { max-width: 1100px; margin: 0 auto; }
        h1 { color:#84a59d; margin-bottom: 6px; }
        .aviso {
            padding:10px 14px; border-radius:10px; font-size:0.85em; margin-bottom:16px;
        }
        .aviso.guardando { background:#e3f2ed; color:#2f665a; }
        .aviso.invitado { background:#fde2e1; color:#8f2d2c; }

        .calendar-wrap { display:flex; gap:20px; margin-top:12px; flex-wrap: wrap; }

        .calendar {
            flex: 1 1 680px;
            background:#fff; border-radius:18px; padding:20px;
            box-shadow:0 6px 20px rgba(0,0,0,0.08);
        }

        .cal-header {
            display:flex; justify-content:space-between; align-items:center;
            margin-bottom: 14px;
        }
        .cal-header button {
            border:none; background:#84a59d; color:#fff; width:36px; height:36px;
            border-radius:50%; font-size:16px; cursor:pointer;
        }
        .cal-header button:hover { background:#6f8f87; }
        #cal-month { font-size: 20px; color:#2d2d2d; text-transform: capitalize; }

        .hoy-btn {
            border:none; background:#f28482; color:#fff; padding:8px 14px;
            border-radius:10px; cursor:pointer; font-weight:bold; font-size:13px;
        }
        .hoy-btn:hover { background:#d96e6c; }

        .cal-weekdays {
            display:grid; grid-template-columns:repeat(7,1fr); gap:6px;
            margin-bottom:6px;
        }
        .cal-weekdays div {
            text-align:center; font-weight:bold; font-size:0.85em; color:#84a59d;
        }

        .cal-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:6px; }
        .cal-cell {
            min-height:96px; border:1px solid #f0ece7; padding:6px;
            border-radius:8px; background:#fff; cursor:pointer;
            display:flex; flex-direction:column; transition: background .15s;
        }
        .cal-cell.empty { background:#fafafa; cursor:default; }
        .cal-cell:not(.empty):hover { background:#f7fbff; }
        .cal-cell.selected { outline:2px solid #84a59d; background:#eef7f4; }
        .cal-cell.today { border:2px solid #f28482; }
        .cal-cell .date { font-weight:700; font-size:0.9em; }
        .cal-cell.today .date {
            color:#fff; background:#f28482; border-radius:50%;
            width:22px; height:22px; display:flex; align-items:center;
            justify-content:center; font-size:0.8em;
        }

        .note {
            background:#f7fbff; border-left:4px solid #3498db; padding:3px 5px;
            margin-top:4px; border-radius:4px; font-size:0.75em;
            overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
        }
        .note.inicial { border-left-color:#f28482; background:#fff2f1; }
        .note-more { font-size:0.7em; color:#888; margin-top:2px; }

        .sidebar {
            flex: 1 1 260px; max-width: 320px;
            background:#fff; border-radius:18px; padding:20px;
            box-shadow:0 6px 20px rgba(0,0,0,0.08); align-self:flex-start;
        }
        .sidebar h3 { margin-top:0; color:#84a59d; }
        .sidebar h4 { margin-top: 18px; color:#2d2d2d; }
        .sidebar label { display:block; margin-top:10px; font-weight:bold; font-size:0.9em; }
        .sidebar input[type=text] {
            width:100%; padding:10px; border:1px solid #d5cec8; border-radius:10px;
            margin-top:4px; font-size:14px;
        }
        .add-btn {
            margin-top:10px; width:100%; border:none; border-radius:10px;
            background:#84a59d; color:#fff; padding:11px; font-weight:bold;
            cursor:pointer;
        }
        .add-btn:hover { background:#6f8f87; }
        .add-btn:disabled { background:#c8c8c8; cursor:not-allowed; }

        #selected-label { font-size:0.85em; color:#666; margin-top:6px; }

        #quick-list { list-style:none; padding:0; margin-top:8px; }
        #quick-list li {
            display:flex; justify-content:space-between; align-items:center;
            background:#f7ede2; padding:8px 10px; border-radius:8px;
            margin-bottom:6px; font-size:0.85em;
        }
        #quick-list button {
            border:none; background:transparent; color:#f28482; cursor:pointer;
            font-weight:bold; font-size:14px;
        }
        #quick-list li.vacio { background:transparent; color:#999; text-align:center; }

        .volver { display:inline-block; margin-top:18px; color:#84a59d; text-decoration:none; font-weight:bold; }
        .volver:hover { text-decoration:underline; }

        @media (max-width: 720px) {
            .calendar, .sidebar { flex: 1 1 100%; max-width: 100%; }
        }
    </style>
</head>
<body>
  <div class="contenedor">
    <h1>Calendario - <%= personaje %></h1>

    <% if (currentUserId) { %>
        <div class="aviso guardando"> Tus notas se guardan en tu cuenta y estarán disponibles en cualquier dispositivo donde inicies sesión.</div>
    <% } else { %>
        <div class="aviso invitado"> No iniciaste sesión, así que las notas solo se guardarán en este navegador y se perderán al borrar el caché. <a href="/">Inicia sesión</a> para guardarlas en tu cuenta.</div>
    <% } %>

    <div class="calendar-wrap">
        <div class="calendar" id="calendar">
            <div class="cal-header">
                <button id="prev" aria-label="Mes anterior">◀</button>
                <strong id="cal-month">Mes Año</strong>
                <button id="next" aria-label="Mes siguiente">▶</button>
            </div>
            <div style="text-align:center; margin-bottom:10px;">
                <button class="hoy-btn" id="ir-hoy">Ir a hoy</button>
            </div>

            <div class="cal-weekdays">
                <div>Dom</div><div>Lun</div><div>Mar</div><div>Mié</div><div>Jue</div><div>Vie</div><div>Sáb</div>
            </div>

            <div class="cal-grid" id="grid">
                <!-- celdas generadas por JS -->
            </div>
        </div>

        <aside class="sidebar">
            <h3>Añadir nota</h3>
            <p id="selected-label">Haz clic en un día del calendario para seleccionarlo.</p>
            <div>
                <label for="nota-text">Nota / Tarea:</label>
                <input id="nota-text" type="text" placeholder="Ej: Entregar informe...">
                <button id="add-note" class="add-btn">Añadir a fecha seleccionada</button>
            </div>
            <hr>
            <h4>Notas del día seleccionado</h4>
            <ul id="quick-list"><li class="vacio">Selecciona un día primero.</li></ul>
            <a class="volver" href="<%= currentUserId ? '/panel/' + currentUserId : '/' %>">← Volver al inicio</a>
        </aside>
    </div>
  </div>

    <script>
        // Calendario con día actual resaltado y notas persistidas.
        // Si hay sesión (currentUserId), las notas se guardan en la BD vía API.
        // Si no hay sesión, se usa localStorage como respaldo temporal.
        const personaje = '<%= personaje %>';
        const currentUserId = <%- currentUserId ? currentUserId : 'null' %>;
        const eventosIniciales = <%- JSON.stringify(eventos || []) %>;

        function toISO(d) {
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${day}`;
        }

        const hoy = new Date();
        const hoyISO = toISO(hoy);
        const state = { date: new Date(hoy.getFullYear(), hoy.getMonth(), 1), selected: null, notas: {} };

        // ---------- Respaldo local (solo si no hay sesión) ----------
        function keyFor() { return 'planner_guest'; }
        function loadLocal() { try { return JSON.parse(localStorage.getItem(keyFor()) || '{}'); } catch (e) { return {}; } }
        function saveLocal(d) { localStorage.setItem(keyFor(), JSON.stringify(d)); }

        // ---------- API backend (si hay sesión) ----------
        async function apiListar() {
            const res = await fetch(`/calendario/notas?usuarioId=${currentUserId}`);
            if (!res.ok) throw new Error('Error al listar notas');
            const data = await res.json();
            const mapa = {};
            (data.notas || []).forEach(n => {
                mapa[n.fecha] = mapa[n.fecha] || [];
                mapa[n.fecha].push(n);
            });
            return mapa;
        }

        async function apiCrear(fecha, titulo, origen) {
            const res = await fetch('/calendario/notas', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ usuarioId: currentUserId, fecha, titulo, origen })
            });
            if (!res.ok) throw new Error('Error al guardar nota');
            return res.json();
        }

        async function apiEliminar(id) {
            const res = await fetch(`/calendario/notas/${id}?usuarioId=${currentUserId}`, { method: 'DELETE' });
            if (!res.ok) throw new Error('Error al eliminar nota');
            return res.json();
        }

        // ---------- Carga inicial de datos ----------
        async function cargarDatos() {
            if (currentUserId) {
                // Sembrar eventos iniciales del backend (idempotente)
                for (const e of eventosIniciales) {
                    try { await apiCrear(e.fecha, e.titulo, 'inicial'); } catch (err) { console.error(err); }
                }
                state.notas = await apiListar();
            } else {
                const data = loadLocal();
                let cambiado = false;
                eventosIniciales.forEach(e => {
                    data[e.fecha] = data[e.fecha] || [];
                    if (!data[e.fecha].some(x => x.titulo === e.titulo)) {
                        data[e.fecha].push({ titulo: e.titulo, origen: 'inicial' });
                        cambiado = true;
                    }
                });
                if (cambiado) saveLocal(data);
                state.notas = data;
            }
        }

        async function agregarNota(fecha, titulo) {
            if (currentUserId) {
                const { nota } = await apiCrear(fecha, titulo, 'personal');
                state.notas[fecha] = state.notas[fecha] || [];
                state.notas[fecha].push(nota);
            } else {
                const data = loadLocal();
                data[fecha] = data[fecha] || [];
                data[fecha].push({ titulo, origen: 'personal', creado: new Date().toISOString() });
                saveLocal(data);
                state.notas = data;
            }
        }

        async function eliminarNota(fecha, idx) {
            const nota = state.notas[fecha][idx];
            if (currentUserId && nota.id) {
                await apiEliminar(nota.id);
            } else {
                const data = loadLocal();
                data[fecha].splice(idx, 1);
                saveLocal(data);
            }
            state.notas[fecha].splice(idx, 1);
        }

        // ---------- Render ----------
        function renderCalendar() {
            const grid = document.getElementById('grid');
            grid.innerHTML = '';
            const year = state.date.getFullYear();
            const month = state.date.getMonth();
            document.getElementById('cal-month').textContent =
                state.date.toLocaleString('es-ES', { month: 'long', year: 'numeric' });

            const startDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            for (let i = 0; i < startDay; i++) {
                const cell = document.createElement('div');
                cell.className = 'cal-cell empty';
                grid.appendChild(cell);
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const dt = new Date(year, month, day);
                const iso = toISO(dt);
                const cell = document.createElement('div');
                cell.className = 'cal-cell';
                if (iso === hoyISO) cell.classList.add('today');
                if (iso === state.selected) cell.classList.add('selected');

                const dateEl = document.createElement('div');
                dateEl.className = 'date';
                dateEl.textContent = day;
                cell.appendChild(dateEl);

                const notes = state.notas[iso] || [];
                notes.slice(0, 3).forEach(n => {
                    const nEl = document.createElement('div');
                    nEl.className = 'note' + (n.origen === 'inicial' ? ' inicial' : '');
                    nEl.textContent = n.titulo;
                    cell.appendChild(nEl);
                });
                if (notes.length > 3) {
                    const more = document.createElement('div');
                    more.className = 'note-more';
                    more.textContent = `+${notes.length - 3} más`;
                    cell.appendChild(more);
                }

                cell.addEventListener('click', () => selectDate(iso));
                grid.appendChild(cell);
            }
        }

        function selectDate(iso) {
            state.selected = iso;
            const dt = new Date(iso + 'T00:00:00');
            document.getElementById('selected-label').textContent =
                'Fecha seleccionada: ' + dt.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            document.getElementById('nota-text').focus();
            renderCalendar();
            renderQuickList();
        }

        function renderQuickList() {
            const list = document.getElementById('quick-list');
            list.innerHTML = '';
            if (!state.selected) {
                list.innerHTML = '<li class="vacio">Selecciona un día primero.</li>';
                return;
            }
            const items = state.notas[state.selected] || [];
            if (items.length === 0) {
                list.innerHTML = '<li class="vacio">Sin notas para este día.</li>';
                return;
            }
            items.forEach((it, idx) => {
                const li = document.createElement('li');
                const span = document.createElement('span');
                span.textContent = it.titulo + (it.origen === 'inicial' ? ' (evento)' : '');
                li.appendChild(span);

                const del = document.createElement('button');
                del.textContent = '✕';
                del.title = 'Eliminar nota';
                del.addEventListener('click', async () => {
                    del.disabled = true;
                    try {
                        await eliminarNota(state.selected, idx);
                        renderCalendar();
                        renderQuickList();
                    } catch (err) {
                        console.error(err);
                        alert('No se pudo eliminar la nota. Intenta de nuevo.');
                        del.disabled = false;
                    }
                });
                li.appendChild(del);
                list.appendChild(li);
            });
        }

        document.getElementById('add-note').addEventListener('click', async () => {
            const boton = document.getElementById('add-note');
            const text = document.getElementById('nota-text').value.trim();
            if (!state.selected) { alert('Selecciona una fecha del calendario primero.'); return; }
            if (!text) { alert('Escribe una descripción para la nota.'); return; }

            boton.disabled = true;
            try {
                await agregarNota(state.selected, text);
                document.getElementById('nota-text').value = '';
                renderCalendar();
                renderQuickList();
            } catch (err) {
                console.error(err);
                alert('No se pudo guardar la nota. Intenta de nuevo.');
            } finally {
                boton.disabled = false;
            }
        });

        document.getElementById('nota-text').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') document.getElementById('add-note').click();
        });

        document.getElementById('prev').addEventListener('click', () => {
            state.date = new Date(state.date.getFullYear(), state.date.getMonth() - 1, 1);
            renderCalendar();
        });
        document.getElementById('next').addEventListener('click', () => {
            state.date = new Date(state.date.getFullYear(), state.date.getMonth() + 1, 1);
            renderCalendar();
        });
        document.getElementById('ir-hoy').addEventListener('click', () => {
            state.date = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
            selectDate(hoyISO);
        });

        // ---------- Inicializar ----------
        (async function init() {
            await cargarDatos();
            renderCalendar();
        })();
    </script>
</body>
</html>
