<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro de estudiante - PLANUTOR</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Arial, sans-serif;
      background: #f7ede2;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 30px;
    }
    .contenedor {
      width: 100%;
      max-width: 550px;
      background: white;
      padding: 40px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
    }
    .logo {
      width: 120px;
      height: 120px;
      object-fit: contain;
      margin-bottom: 15px;
    }
    h1 { color: #84a59d; margin-bottom: 10px; }
    .subtitulo { color: #666; margin-bottom: 24px; }
    .alerta {
      margin-bottom: 18px;
      padding: 12px 14px;
      border-radius: 10px;
      text-align: left;
      font-size: 14px;
    }
    .alerta.error {
      background: #fde2e1;
      color: #8f2d2c;
    }
    .alerta.ok {
      background: #e3f2ed;
      color: #2f665a;
    }
    label {
      display: block;
      text-align: left;
      margin-top: 15px;
      margin-bottom: 7px;
      font-weight: bold;
      color: #333;
    }
    input, select {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
    }
    .campo-colegio {
      position: relative;
    }
    .opciones-colegio {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: white;
      border: 1px solid #ccc;
      border-top: none;
      border-radius: 0 0 8px 8px;
      max-height: 220px;
      overflow-y: auto;
      z-index: 10;
      text-align: left;
    }
    .opcion-colegio {
      padding: 10px 12px;
      cursor: pointer;
      font-size: 15px;
    }
    .opcion-colegio:hover {
      background: #f7ede2;
    }
    .opcion-otro {
      color: #f28482;
      font-style: italic;
    }
    button {
      width: 100%;
      margin-top: 25px;
      padding: 15px;
      border: none;
      border-radius: 10px;
      background: #84a59d;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }
    .volver {
      display: block;
      margin-top: 20px;
      color: #f28482;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="contenedor">
    <img src="/imagenes/logo-planutor.png" alt="Logo PLANUTOR" class="logo">
    <h1>Registro de estudiante</h1>
    <p class="subtitulo">Crea tu cuenta en PLANUTOR</p>

    <% if (error) { %>
      <div class="alerta error"><%= error %></div>
    <% } %>

    <% if (mensaje) { %>
      <div class="alerta ok"><%= mensaje %></div>
    <% } %>

    <form action="/registro-estudiante" method="POST">
      <label for="institucionBusqueda">Institucion</label>
      <div class="campo-colegio">
        <input type="text" id="institucionBusqueda" placeholder="Escribe el nombre de tu colegio..." value="<%= valores.institucion %>" autocomplete="off">
        <div class="opciones-colegio" id="institucionOpciones"></div>
      </div>
      <input type="hidden" id="institucion" name="institucion" value="<%= valores.institucion %>" required>

      <label for="nombre">Nombre completo</label>
      <input
        type="text"
        id="nombre"
        name="nombre"
        placeholder="Escribe tu nombre completo"
        value="<%= valores.nombre %>"
        required
      >

      <label for="correo">Correo electronico</label>
      <input
        type="email"
        id="correo"
        name="correo"
        placeholder="ejemplo@gmail.com"
        value="<%= valores.correo %>"
        required
      >

      <label for="nivel">Nivel educativo</label>
      <select id="nivel" name="nivel" required>
        <option value="">Selecciona tu nivel</option>
        <option value="primaria" <%= valores.nivel === 'primaria' ? 'selected' : '' %>>Primaria</option>
        <option value="bachillerato" <%= valores.nivel === 'bachillerato' ? 'selected' : '' %>>Bachillerato</option>
      </select>

      <label for="grado">Grado</label>
      <select id="grado" name="grado" required>
        <option value="">Selecciona tu grado</option>
        <% for (let grado = 1; grado <= 11; grado += 1) { %>
          <option value="<%= grado %>" <%= valores.grado === String(grado) ? 'selected' : '' %>><%= grado %>°</option>
        <% } %>
      </select>

      <label for="grupo">Grupo</label>
      <input
        type="text"
        id="grupo"
        name="grupo"
        placeholder="Ejemplo: 10A"
        value="<%= valores.grupo %>"
        required
      >

      <label for="password">Contrasena</label>
      <input
        type="password"
        id="password"
        name="password"
        placeholder="Crea tu contrasena"
        required
      >

      <label for="confirmarPassword">Confirmar contrasena</label>
      <input
        type="password"
        id="confirmarPassword"
        name="confirmarPassword"
        placeholder="Repite tu contrasena"
        required
      >

      <button type="submit">REGISTRARME</button>
    </form>

    <a href="/" class="volver">Volver</a>
  </div>

  <script src="/js/colegios.js"></script>
  <script>
    initAutocompleteColegio({
      inputId: 'institucionBusqueda',
      hiddenId: 'institucion',
      listId: 'institucionOpciones'
    });
  </script>
</body>
</html>